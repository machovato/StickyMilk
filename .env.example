# StickyMilk Lab Environment Configuration

# Password required to access /recipes/new and /recipes/[slug]/edit
ADMIN_PASSWORD=stickymilk-lab-admin

# Gemini: video translation (reel_extractor.py) and vendor recipe import
GEMINI_API_KEY=

# YouTube Data API v3: trend scout (scripts/trend-scout.ts). See TREND_SCOUT.md.
YOUTUBE_API_KEY=

# Python used to run lib/translator/reel_extractor.py (default: python3)
# PYTHON_BIN=python3

# SQLite database (review queue, ratings). Used by `npm run db:push` and the app.
DATABASE_URL="file:./prisma/dev.db"
